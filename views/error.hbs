<section class="page-heading" aria-labelledby="page-title">
  <p class="eyebrow">Quản lý sách</p>
  <h1 id="page-title">{{title}}</h1>
</section>
<section class="card error-card" aria-labelledby="error-title">
  <span class="status-badge status-badge-error">Không thể hoàn tất</span>
  <h2 id="error-title">Vui lòng thử lại</h2>
  <p>{{message}}</p>
  <a class="button" href="/">Về trang chủ</a>
</section>
