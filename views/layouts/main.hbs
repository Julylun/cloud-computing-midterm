<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="description" content="Hệ thống quản lý sách của Hoàng Xuân Luân — 23IT150.">
    <title>{{#if title}}{{title}}{{else}}Quản lý sách{{/if}} · 23IT150</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Quản lý sách — Trang chủ">
          <span class="brand-mark" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M12 6.5C9.3 4.5 6.2 4 3 4.7v14c3.2-.7 6.3-.2 9 1.8m0-14c2.7-2 5.8-2.5 9-1.8v14c-3.2-.7-6.3-.2-9 1.8m0-14v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>Thư viện<span class="brand-subtitle">Quản lý sách</span></span>
        </a>
        <span class="header-label">Điện toán đám mây <span aria-hidden="true">/</span> Giữa kỳ</span>
      </div>
    </header>
    <main class="container main-content" id="main-content" tabindex="-1">
      {{{body}}}
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-name">{{student.fullName}}</p>
          <p class="footer-note">Hệ thống quản lý sách · Bài kiểm tra giữa kỳ</p>
        </div>
        <dl class="student-details">
          <div><dt>Mã sinh viên</dt><dd>{{student.studentId}}</dd></div>
          <div><dt>Tiền tố mã sách</dt><dd>{{student.productPrefix}}</dd></div>
          <div><dt>Thuế VAT</dt><dd>{{student.vatPercent}}%</dd></div>
        </dl>
      </div>
    </footer>
  </body>
</html>
