# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Step Database: both URIs must use DB_23IT150 and their own user.
MONGODB_READ_URI=
MONGODB_WRITE_URI=

# Optional local workaround only if the system DNS refuses Atlas SRV queries.
# Example: 1.1.1.1,8.8.8.8. Leave empty on Render unless needed.
MONGODB_DNS_SERVERS=

# Step Session: at least 32 random bytes; same value for every instance.
SESSION_SECRET=
